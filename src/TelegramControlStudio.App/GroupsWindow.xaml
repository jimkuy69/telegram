<Window x:Class="TelegramControlStudio.App.GroupsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Groups &amp; Channels" Width="1050" Height="650" Background="#08111F" Foreground="#E8F0FA">
 <Window.Resources><Style TargetType="{x:Type DataGridColumnHeader}"><Setter Property="Foreground" Value="#0B1B33"/><Setter Property="Background" Value="#B9C7DA"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8,5"/></Style><Style TargetType="{x:Type DataGridCell}"><Setter Property="Foreground" Value="#E8F0FA"/><Setter Property="TextElement.Foreground" Value="#E8F0FA"/><Setter Property="Background" Value="Transparent"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#2563EB"/></Trigger></Style.Triggers></Style><Style TargetType="{x:Type DataGridRow}"><Setter Property="Foreground" Value="#E8F0FA"/><Setter Property="TextElement.Foreground" Value="#E8F0FA"/><Setter Property="Background" Value="#0D1A2D"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#2563EB"/></Trigger></Style.Triggers></Style><Style x:Key="GridTextCell" TargetType="{x:Type TextBlock}"><Setter Property="Foreground" Value="#E8F0FA"/><Setter Property="TextWrapping" Value="NoWrap"/></Style></Window.Resources>
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14"><DockPanel><TextBlock Text="กลุ่มและแชนแนล" FontSize="24" FontWeight="SemiBold"/><Button Content="Sync จาก TDLib" Click="Sync_Click" HorizontalAlignment="Right" Padding="14,8" Background="#6941E8" Foreground="White"/></DockPanel><TextBlock Text="เลือกแถวแล้วกด ดูสมาชิก/รายละเอียด (ดับเบิลคลิกก็ได้) • ข้อมูลตามที่ Telegram เปิดเผยและสิทธิ์ของบัญชีเท่านั้น" Foreground="#8FA6C6" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
  <DataGrid Grid.Row="1" ItemsSource="{Binding Groups}" AutoGenerateColumns="False" IsReadOnly="True" Background="#0A1627" Foreground="#E8F0FA" BorderBrush="#203A5D" RowBackground="#0D1A2D" AlternatingRowBackground="#10213A" MouseDoubleClick="Group_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="ชื่อ" Binding="{Binding Title}" Width="*" ElementStyle="{StaticResource GridTextCell}"/><DataGridTextColumn Header="ประเภท" Binding="{Binding Kind}" Width="120" ElementStyle="{StaticResource GridTextCell}"/><DataGridTextColumn Header="Chat ID" Binding="{Binding ChatId}" Width="140" ElementStyle="{StaticResource GridTextCell}"/><DataGridTextColumn Header="สมาชิกที่เห็นได้" Binding="{Binding MemberCount}" Width="130" ElementStyle="{StaticResource GridTextCell}"/><DataGridCheckBoxColumn Header="อ่านสมาชิก" Binding="{Binding CanViewMembers}" Width="90"/><DataGridCheckBoxColumn Header="ส่งข้อความ" Binding="{Binding CanSendMessages}" Width="90"/><DataGridCheckBoxColumn Header="เชิญสมาชิก" Binding="{Binding CanInviteUsers}" Width="90"/><DataGridTemplateColumn Header="การทำงาน" Width="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="ดูสมาชิก/รายละเอียด" Click="ViewDetails_Click" Padding="8,5" Margin="2"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
  <StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock x:Name="StatusText" Foreground="#60A5FA" TextWrapping="Wrap"/><TextBlock Text="ข้อจำกัด: Group และ Channel อาจเปิดเผยสมาชิกและสิทธิ์ไม่เท่ากัน ระบบจะไม่สรุปว่าเป็นสมาชิกทั้งหมดหาก Telegram ส่งข้อมูลมาไม่ครบ" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
 </Grid>
</Window>

