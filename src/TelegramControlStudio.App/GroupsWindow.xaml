<Window x:Class="TelegramControlStudio.App.GroupsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Groups &amp; Channels" Width="1050" Height="650" Background="#08111F" Foreground="#F4F7FF">
 <Window.Resources><Style TargetType="{x:Type DataGridColumnHeader}"><Setter Property="Foreground" Value="#0B1B33"/><Setter Property="Background" Value="#B9C7DA"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8,5"/></Style><Style TargetType="{x:Type DataGridCell}"><Setter Property="Foreground" Value="#D9E2F2"/></Style></Window.Resources>
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14"><DockPanel><TextBlock Text="กลุ่มและแชนแนล" FontSize="24" FontWeight="SemiBold"/><Button Content="Sync จาก TDLib" Click="Sync_Click" HorizontalAlignment="Right" Padding="14,8" Background="#6941E8" Foreground="White"/></DockPanel><TextBlock Text="ข้อมูลที่แสดงเป็นข้อมูลที่ Telegram เปิดเผยและสิทธิ์ของบัญชีเท่านั้น" Foreground="#8FA6C6" Margin="0,5,0,0"/></StackPanel>
  <DataGrid Grid.Row="1" ItemsSource="{Binding Groups}" AutoGenerateColumns="False" IsReadOnly="True" Background="#0A1627" Foreground="#D9E2F2" BorderBrush="#203A5D" RowBackground="#0D1A2D" AlternatingRowBackground="#10213A" MouseDoubleClick="Group_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="ชื่อ" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="ประเภท" Binding="{Binding Kind}" Width="120"/><DataGridTextColumn Header="Chat ID" Binding="{Binding ChatId}" Width="140"/><DataGridTextColumn Header="สมาชิกที่เห็นได้" Binding="{Binding MemberCount}" Width="130"/><DataGridCheckBoxColumn Header="อ่านสมาชิก" Binding="{Binding CanViewMembers}" Width="90"/><DataGridCheckBoxColumn Header="ส่งข้อความ" Binding="{Binding CanSendMessages}" Width="90"/><DataGridCheckBoxColumn Header="เชิญสมาชิก" Binding="{Binding CanInviteUsers}" Width="90"/></DataGrid.Columns></DataGrid>
  <StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock x:Name="StatusText" Foreground="#60A5FA" TextWrapping="Wrap"/><TextBlock Text="ข้อจำกัด: Group และ Channel อาจเปิดเผยสมาชิกและสิทธิ์ไม่เท่ากัน ระบบจะไม่สรุปว่าเป็นสมาชิกทั้งหมดหาก Telegram ส่งข้อมูลมาไม่ครบ" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
 </Grid>
</Window>

