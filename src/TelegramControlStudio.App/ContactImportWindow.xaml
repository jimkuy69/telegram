<Window x:Class="TelegramControlStudio.App.ContactImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Import Contacts" Width="760" Height="520" Background="#08111F" Foreground="#F4F7FF" WindowStartupLocation="CenterOwner">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="นำเข้า Contacts จาก CSV / Excel" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="SummaryText" Text="เลือกไฟล์เพื่อเริ่ม Preview" Foreground="#AFC3DF" Margin="0,5,0,12"/></StackPanel>
  <TextBox x:Name="PreviewText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0D1A2D" Foreground="#D9E2F2" Padding="12"/>
  <DockPanel Grid.Row="2" Margin="0,14,0,0"><Button Content="เลือก CSV / XLSX" Click="Choose_Click"/><Button Content="ยืนยัน Import" Click="Confirm_Click" Background="#6941E8" Margin="10,0,0,0"/><Button Content="ปิด" Click="Close_Click" HorizontalAlignment="Right" Margin="10,0,0,0"/></DockPanel>
 </Grid>
</Window>

