<Window x:Class="TelegramControlStudio.App.ActivityLogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Activity Log" Width="1100" Height="650" Background="#08111F" Foreground="#F4F7FF"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,14"><TextBlock Text="ประวัติและ Audit Timeline" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="เหตุการณ์ถูก Redact และอ่านจากฐานข้อมูล Local ตามบัญชีที่เลือก" Foreground="#8FA6C6"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True" Background="#0A1627" Foreground="#D9E2F2"><DataGrid.Columns><DataGridTextColumn Header="เวลา" Binding="{Binding CreatedAt}" Width="190"/><DataGridTextColumn Header="ระดับ" Binding="{Binding Level}" Width="90"/><DataGridTextColumn Header="ประเภท" Binding="{Binding EventType}" Width="160"/><DataGridTextColumn Header="Job ID" Binding="{Binding JobId}" Width="220"/><DataGridTextColumn Header="รายละเอียด" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="ไม่แสดง OTP, 2FA, Session, api_hash หรือข้อมูลลับ" Foreground="#FBBF24" Margin="0,12,0,0"/></Grid></Window>

