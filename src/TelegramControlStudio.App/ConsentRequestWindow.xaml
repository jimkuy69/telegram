<Window x:Class="TelegramControlStudio.App.ConsentRequestWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ขอความยินยอม (Opt-in)" Width="980" Height="720" Background="{StaticResource WindowBg}" Foreground="{StaticResource TextPrimary}" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="Cell" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="ขอความยินยอมก่อนเริ่มส่งข้อความ" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0" />
            <TextBlock x:Name="SafetyWarningText" Foreground="{StaticResource WarningText}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,14,0,0">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="เทมเพลต (ไม่บังคับ)" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                    <ComboBox x:Name="TemplateBox" Width="360" Margin="12,0,0,0" HorizontalAlignment="Left" SelectionChanged="Template_Changed" />
                </DockPanel>
                <TextBlock Text="ข้อความที่จะส่งไปขอความยินยอม — แสดงเฉพาะกับผู้ที่ยังไม่มี Consent และมีเบอร์ของเขาอยู่ในสมุดรายชื่อ" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,10,0,5" />
                <TextBox x:Name="BodyBox" Height="86" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="9" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" x:Name="PlanText" Foreground="{StaticResource TextMuted}" Margin="0,14,0,8" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" x:Name="EligibleHeader" Text="ถามได้" FontWeight="SemiBold" Margin="0,0,0,6" />
                <DataGrid x:Name="EligibleGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#0D1A2D" Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource Border}" RowBackground="#0D1A2D" AlternatingRowBackground="#10213A">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Telegram ID" Binding="{Binding TelegramUserId}" Width="120" ElementStyle="{StaticResource Cell}" />
                        <DataGridTextColumn Header="ชื่อ" Binding="{Binding DisplayName}" Width="*" ElementStyle="{StaticResource Cell}" />
                        <DataGridTextColumn Header="สถานะ" Binding="{Binding Reason}" Width="150" ElementStyle="{StaticResource Cell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" x:Name="ExcludedHeader" Text="ถูกข้าม" FontWeight="SemiBold" Margin="0,0,0,6" />
                <DataGrid x:Name="ExcludedGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#0D1A2D" Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource Border}" RowBackground="#0D1A2D" AlternatingRowBackground="#10213A">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Telegram ID" Binding="{Binding TelegramUserId}" Width="110" ElementStyle="{StaticResource Cell}" />
                        <DataGridTextColumn Header="ชื่อ" Binding="{Binding DisplayName}" Width="150" ElementStyle="{StaticResource Cell}" />
                        <DataGridTextColumn Header="เหตุผลที่ไม่ถาม" Binding="{Binding Reason}" Width="*" ElementStyle="{StaticResource Cell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <CheckBox x:Name="ConfirmBox" Content="ยืนยันว่าข้อความนี้ขอความยินยอมจริง และจะส่งเฉพาะรายการที่ระบบคำนวณให้เท่านั้น" Foreground="{StaticResource TextPrimary}" />
            <TextBlock x:Name="StatusText" Foreground="{StaticResource InfoText}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="QueueButton" Content="สร้างคิวคำขอ" Style="{StaticResource PrimaryButton}" Height="40" Padding="18,0" Click="Queue_Click" />
                <Button Content="เปิดหน้าต่างคิวงาน" Style="{StaticResource SecondaryButton}" Height="40" Margin="10,0,0,0" Click="OpenQueue_Click" />
                <Button Content="ปิด" Style="{StaticResource GhostButton}" Height="40" Margin="10,0,0,0" Click="Close_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
