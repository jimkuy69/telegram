<Window x:Class="TelegramControlStudio.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Settings" Width="700" Height="860" Background="{StaticResource WindowBg}" Foreground="{StaticResource TextPrimary}">
    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="ตั้งค่า Telegram และการกู้คืนข้อมูล" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="api_hash จะถูกเข้ารหัสด้วย Windows DPAPI และจะไม่แสดงซ้ำหลังบันทึก" Foreground="{StaticResource TextMuted}" Margin="0,6,0,18" />

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="ความปลอดภัยในการส่ง" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="โหมดทดสอบเป็นค่าเริ่มต้น: ระบบจะส่งเฉพาะ Telegram User ID ที่อยู่ใน allowlist เท่านั้น ส่วนหยุดฉุกเฉินจะบล็อกการส่งทั้งหมดทันที" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,12" />
                    <CheckBox x:Name="TestModeBox" Content="เปิดโหมดทดสอบ (ส่งเฉพาะ allowlist)" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="Telegram User ID ที่อนุญาต (คั่นด้วยเครื่องหมายจุลภาคหรือขึ้นบรรทัดใหม่)" Foreground="{StaticResource TextSecondary}" Margin="0,12,0,5" />
                    <TextBox x:Name="AllowlistBox" Height="84" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="บันทึกความปลอดภัย" Click="SaveSafety_Click" Style="{StaticResource PrimaryButton}" />
                        <Button x:Name="ClearEmergencyButton" Content="ปลดหยุดฉุกเฉิน" Click="ClearEmergency_Click" Style="{StaticResource DangerButton}" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="SafetyStatusText" Foreground="{StaticResource InfoText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="การขอความยินยอม (Opt-in)" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="ส่งหาคนที่ไม่รู้จักไม่ได้จนกว่าเจ้าของเบอร์จะตอบตกลง ระบบจึงจะถามเฉพาะคนที่ยังไม่มี Consent มีเบอร์ของเขาอยู่ในสมุดรายชื่อ และยังไม่เคยปฏิเสธ" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,12" />
                    <TextBlock Text="ระยะห่างในการถามคนเดิม (วัน)" Foreground="{StaticResource TextSecondary}" />
                    <TextBox x:Name="ConsentCooldownBox" Padding="9" Margin="0,6,0,12" ToolTip="อย่างน้อยกี่วันถึงจะถามคนเดิมได้อีก" />
                    <TextBlock Text="จำนวนครั้งที่ถามได้ต่อวัน (ต่อบัญชี)" Foreground="{StaticResource TextSecondary}" />
                    <TextBox x:Name="ConsentDailyLimitBox" Padding="9" Margin="0,6,0,12" ToolTip="0 = ปิดการขอความยินยอมทั้งหมด" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="บันทึกขีดจำกัด Opt-in" Click="SaveConsentLimits_Click" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                    <TextBlock x:Name="ConsentLimitsStatusText" Foreground="{StaticResource InfoText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Telegram API ID" Foreground="{StaticResource TextSecondary}" />
            <TextBox x:Name="ApiIdBox" Padding="9" Margin="0,6,0,12" />
            <TextBlock Text="Telegram API Hash" Foreground="{StaticResource TextSecondary}" />
            <PasswordBox x:Name="ApiHashBox" Padding="9" Margin="0,6,0,12" />
            <StackPanel Orientation="Horizontal">
                <Button Content="บันทึก TDLib Configuration" Click="SaveTdLib_Click" Style="{StaticResource PrimaryButton}" />
                <Button Content="เลือก tdjson.dll" Click="SelectNative_Click" Margin="10,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="NativePathText" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,10,0,10" />
            <Button Content="ทดสอบและเชื่อมต่อ Native TDLib" Click="ConnectNative_Click" Background="#0F766E" Foreground="White" HorizontalAlignment="Left" />
            <TextBlock Text="การเชื่อมต่อจะผ่าน Hash Gate ก่อนสร้าง Session แยกบัญชี" Foreground="{StaticResource WarningText}" TextWrapping="Wrap" Margin="0,10,0,10" />
            <Button Content="ออกจากระบบบัญชีนี้" Click="Logout_Click" Background="#7F1D3A" Foreground="White" HorizontalAlignment="Left" Margin="0,0,0,18" />

            <TextBlock Text="Database Path" Foreground="{StaticResource TextSecondary}" />
            <TextBox x:Name="DatabasePathBox" IsReadOnly="True" Padding="9" Margin="0,6,0,18" />
            <StackPanel Orientation="Horizontal">
                <Button Content="สร้าง Encrypted Backup" Click="Backup_Click" />
                <Button Content="Restore Backup" Click="Restore_Click" Margin="10,0,0,0" />
            </StackPanel>
            <TextBlock Text="คำเตือน: Restore จะเขียนทับ Database ปัจจุบัน ควรสร้าง Backup ก่อนทุกครั้ง" Foreground="{StaticResource WarningText}" TextWrapping="Wrap" Margin="0,24,0,0" />
            <TextBlock x:Name="StatusText" Foreground="{StaticResource InfoText}" TextWrapping="Wrap" Margin="0,14,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
