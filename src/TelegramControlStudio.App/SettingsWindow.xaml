<Window x:Class="TelegramControlStudio.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Settings" Width="650" Height="390" Background="#08111F" Foreground="#F4F7FF"><Grid Margin="20"><StackPanel><TextBlock Text="ตั้งค่าและการกู้คืนข้อมูล" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="ข้อมูล Backup ใช้ Windows DPAPI ของผู้ใช้ Windows ปัจจุบัน" Foreground="#8FA6C6" Margin="0,6,0,20"/><TextBlock Text="Database Path" Foreground="#AFC3DF"/><TextBox x:Name="DatabasePathBox" IsReadOnly="True" Padding="9" Margin="0,6,0,18"/><StackPanel Orientation="Horizontal"><Button Content="สร้าง Encrypted Backup" Click="Backup_Click" Padding="14,9"/><Button Content="Restore Backup" Click="Restore_Click" Padding="14,9" Margin="10,0,0,0"/></StackPanel><TextBlock Text="คำเตือน: Restore จะเขียนทับ Database ปัจจุบัน ควรสร้าง Backup ก่อนทุกครั้ง" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,24,0,0"/><TextBlock x:Name="StatusText" Foreground="#60A5FA" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></Grid></Window>

