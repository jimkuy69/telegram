<Window x:Class="TelegramControlStudio.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Settings" Width="700" Height="700" Background="#08111F" Foreground="#F4F7FF"><ScrollViewer><Grid Margin="20"><StackPanel><TextBlock Text="ตั้งค่า Telegram และการกู้คืนข้อมูล" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="api_hash จะถูกเข้ารหัสด้วย Windows DPAPI และจะไม่แสดงซ้ำหลังบันทึก" Foreground="#8FA6C6" Margin="0,6,0,20"/><TextBlock Text="Telegram API ID" Foreground="#AFC3DF"/><TextBox x:Name="ApiIdBox" Padding="9" Margin="0,6,0,12"/><TextBlock Text="Telegram API Hash" Foreground="#AFC3DF"/><PasswordBox x:Name="ApiHashBox" Padding="9" Margin="0,6,0,12"/><StackPanel Orientation="Horizontal"><Button Content="บันทึก TDLib Configuration" Click="SaveTdLib_Click" Padding="14,9" Background="#6941E8" Foreground="White"/><Button Content="เลือก tdjson.dll" Click="SelectNative_Click" Padding="14,9" Margin="10,0,0,0"/></StackPanel><TextBlock x:Name="NativePathText" Foreground="#8FA6C6" TextWrapping="Wrap" Margin="0,10,0,10"/><Button Content="ทดสอบและเชื่อมต่อ Native TDLib" Click="ConnectNative_Click" Padding="14,9" Background="#0F766E" Foreground="White" HorizontalAlignment="Left"/><TextBlock Text="การเชื่อมต่อจะผ่าน Hash Gate ก่อนสร้าง Session แยกบัญชี" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,10,0,18"/><TextBlock Text="Database Path" Foreground="#AFC3DF"/><TextBox x:Name="DatabasePathBox" IsReadOnly="True" Padding="9" Margin="0,6,0,18"/><StackPanel Orientation="Horizontal"><Button Content="สร้าง Encrypted Backup" Click="Backup_Click" Padding="14,9"/><Button Content="Restore Backup" Click="Restore_Click" Padding="14,9" Margin="10,0,0,0"/></StackPanel><TextBlock Text="คำเตือน: Restore จะเขียนทับ Database ปัจจุบัน ควรสร้าง Backup ก่อนทุกครั้ง" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,24,0,0"/><TextBlock x:Name="StatusText" Foreground="#60A5FA" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></Grid></ScrollViewer></Window>

