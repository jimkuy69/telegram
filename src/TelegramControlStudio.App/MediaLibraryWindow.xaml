<Window x:Class="TelegramControlStudio.App.MediaLibraryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Media Library" Width="980" Height="620" Background="#08111F" Foreground="#F4F7FF" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="18">
  <StackPanel DockPanel.Dock="Top"><TextBlock Text="Media Library" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="ไฟล์จัดเก็บในเครื่องเท่านั้น • ตรวจสอบด้วย SHA-256" Foreground="#AFC3DF" Margin="0,5,0,14"/></StackPanel>
  <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0"><Button Content="Refresh" Click="Refresh_Click" Width="100"/><Button Content="Soft Delete" Click="Delete_Click" Width="110" Margin="10,0,0,0" Background="#7F1D3A" Foreground="White"/><Button Content="ปิด" Click="Close_Click" Width="90" HorizontalAlignment="Right"/></DockPanel>
  <DataGrid x:Name="MediaGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" Background="#0A1627" Foreground="#D9E2F2" BorderBrush="#203A5D" RowBackground="#0D1A2D" AlternatingRowBackground="#10213A"><DataGrid.Columns><DataGridTextColumn Header="ชื่อไฟล์" Binding="{Binding FileName}" Width="180"/><DataGridTextColumn Header="MIME" Binding="{Binding MimeType}" Width="140"/><DataGridTextColumn Header="ขนาด" Binding="{Binding SizeBytes}" Width="90"/><DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="*"/><DataGridTextColumn Header="Local Path" Binding="{Binding LocalPath}" Width="240"/></DataGrid.Columns></DataGrid>
 </DockPanel>
</Window>