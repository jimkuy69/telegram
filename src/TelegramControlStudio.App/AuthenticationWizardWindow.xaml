<Window x:Class="TelegramControlStudio.App.AuthenticationWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telegram Authentication" Width="560" Height="520"
        WindowStartupLocation="CenterOwner" Background="#0B1627" Foreground="#F4F7FF">
    <StackPanel Margin="28">
        <TextBlock Text="เชื่อมต่อบัญชี Telegram" FontSize="25" FontWeight="SemiBold"/>
        <TextBlock Text="Authentication Wizard" Foreground="#9C6CFF" Margin="0,6,0,18"/>
        <Border Background="#101F35" CornerRadius="8" Padding="14" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="สถานะปัจจุบัน" Foreground="#AFC3DF"/>
                <TextBlock x:Name="StateText" Text="รอสถานะจาก TDLib" FontSize="20" Foreground="#60A5FA" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock Text="ข้อมูลสำหรับขั้นตอนปัจจุบัน" Foreground="#AFC3DF"/>
        <TextBox x:Name="PhoneInputBox" Margin="0,7,0,14" Padding="11" Background="#101F35" Foreground="#D9E2F2" BorderBrush="#29486E"/>
        <PasswordBox x:Name="SecretInputBox" Margin="0,7,0,14" Padding="11" Background="#101F35" Foreground="#D9E2F2" BorderBrush="#29486E" Visibility="Collapsed"/>
        <StackPanel x:Name="RegistrationPanel" Visibility="Collapsed" Margin="0,7,0,14">
            <TextBox x:Name="RegistrationFirstNameBox" Padding="11" Margin="0,0,0,8" Background="#101F35" Foreground="#D9E2F2" BorderBrush="#29486E"/>
            <TextBox x:Name="RegistrationLastNameBox" Padding="11" Background="#101F35" Foreground="#D9E2F2" BorderBrush="#29486E"/>
        </StackPanel>
        <TextBlock Text="ช่องนี้ใช้รับ OTP หรือ 2FA ชั่วคราวเท่านั้น และจะไม่ถูกเขียนลง Log หรือฐานข้อมูล" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,0,0,18"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="ปิด" Click="Close_Click" Margin="0,0,10,0"/>
            <Button x:Name="SubmitButton" Content="ส่งข้อมูลขั้นตอนนี้" Click="Submit_Click" Background="#6941E8" Foreground="White"/>
        </StackPanel>
        <TextBlock x:Name="NoticeText" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,18,0,0"/>
    </StackPanel>
</Window>
