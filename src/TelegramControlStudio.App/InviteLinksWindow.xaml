<Window x:Class="TelegramControlStudio.App.InviteLinksWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Invite Links" Width="1000" Height="560" Background="#08111F" Foreground="#F4F7FF" WindowStartupLocation="CenterOwner">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14"><TextBlock Text="Invite Links" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="ลิงก์ที่บันทึกจาก Telegram • ใช้ Join Request เป็นค่าแนะนำ" Foreground="#8FA6C6" Margin="0,5,0,0"/></StackPanel>
  <DataGrid x:Name="LinksGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="#0A1627" Foreground="#D9E2F2" BorderBrush="#203A5D" RowBackground="#0D1A2D" AlternatingRowBackground="#10213A"><DataGrid.Columns><DataGridTextColumn Header="Chat ID" Binding="{Binding ChatId}" Width="120"/><DataGridTextColumn Header="Invite URL" Binding="{Binding InviteUrl}" Width="*"/><DataGridTextColumn Header="หมดอายุ" Binding="{Binding ExpiresAt}" Width="180"/><DataGridTextColumn Header="จำกัดการใช้" Binding="{Binding UsageLimit}" Width="100"/><DataGridCheckBoxColumn Header="Join Request" Binding="{Binding CreatesJoinRequest}" Width="100"/><DataGridTextColumn Header="สถานะ" Binding="{Binding RevokedAt}" Width="150"/><DataGridTextColumn Header="สร้างเมื่อ" Binding="{Binding CreatedAt}" Width="180"/></DataGrid.Columns></DataGrid>
  <DockPanel Grid.Row="2" Margin="0,14,0,0"><Button Content="Refresh" Click="Refresh_Click" Width="100"/><Button Content="ปิด" Click="Close_Click" Width="90" HorizontalAlignment="Right"/></DockPanel>
 </Grid>
</Window>