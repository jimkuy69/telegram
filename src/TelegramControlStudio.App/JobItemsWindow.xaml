<Window x:Class="TelegramControlStudio.App.JobItemsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Job Items" Width="900" Height="560" Background="#08111F" Foreground="#F4F7FF"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="ผลลัพธ์รายผู้รับ" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,14"/><DataGrid Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" Background="#0A1627" Foreground="#D9E2F2"><DataGrid.Columns><DataGridTextColumn Header="Target ID" Binding="{Binding TargetId}" Width="170"/><DataGridTextColumn Header="สถานะ" Binding="{Binding Status}" Width="130"/><DataGridTextColumn Header="Retry" Binding="{Binding RetryCount}" Width="80"/><DataGridTextColumn Header="Error" Binding="{Binding LastError}" Width="*"/><DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAt}" Width="190"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="รายการนี้ยังเป็น local queue และยังไม่ส่งข้อความจริง" Foreground="#FBBF24" Margin="0,12,0,0"/></Grid></Window>

