<Window x:Class="TelegramControlStudio.App.JobItemsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Job Items" Width="900" Height="560" Background="#08111F" Foreground="#E8F0FA"><Window.Resources><Style x:Key="GridTextCell" TargetType="{x:Type TextBlock}"><Setter Property="Foreground" Value="#AFC3DA"/><Setter Property="TextWrapping" Value="NoWrap"/></Style></Window.Resources>
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="ผลลัพธ์รายผู้รับ" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,14"/><DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" IsReadOnly="True" Background="#0A1627" Foreground="#AFC3DA"><DataGrid.Columns><DataGridTextColumn Header="Target ID" Binding="{Binding TargetId}" Width="170" ElementStyle="{StaticResource GridTextCell}"/><DataGridTextColumn Header="สถานะ" Binding="{Binding Status}" Width="130" ElementStyle="{StaticResource GridTextCell}"/><DataGridTextColumn Header="Retry" Binding="{Binding RetryCount}" Width="80" ElementStyle="{StaticResource GridTextCell}"/><DataGridTextColumn Header="Error" Binding="{Binding LastError}" Width="*" ElementStyle="{StaticResource GridTextCell}"/><DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAt}" Width="190" ElementStyle="{StaticResource GridTextCell}"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Retry รายการที่เลือก" Click="Retry_Click" Padding="12,8"/><TextBlock Text="แสดงผลลัพธ์รายผู้รับ • งานส่งจริงจะแสดงสถานะจาก Telegram" Foreground="#FBBF24" VerticalAlignment="Center" Margin="16,0,0,0"/></StackPanel></Grid></Window>

