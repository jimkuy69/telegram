<Window x:Class="TelegramControlStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telegram Control Studio"
        Width="1200" Height="680" MinWidth="1180" MinHeight="640"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        FontFamily="Segoe UI, Leelawadee UI"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <DataTemplate x:Key="ConsentBadge">
            <Border x:Name="Badge" CornerRadius="9" Padding="9,4" HorizontalAlignment="Left" Background="{StaticResource SuccessSoft}">
                <TextBlock x:Name="BadgeText" Text="{Binding Consent}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessText}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Consent}" Value="Opt-out">
                    <Setter TargetName="Badge" Property="Background" Value="{StaticResource DangerSoft}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource DangerText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Consent}" Value="ยังไม่อนุญาต">
                    <Setter TargetName="Badge" Property="Background" Value="{StaticResource WarningSoft}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource WarningText}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{StaticResource TopBarBg}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="19" Background="#229ED9" Margin="0,0,12,0">
                        <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Telegram Control Studio" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="v0.1" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <Border Background="{StaticResource SuccessSoft}" BorderBrush="#1F5A38" BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LOCAL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessText}" />
                    </Border>
                    <Border x:Name="SafetyBadge" Background="{StaticResource WarningSoft}" BorderBrush="#6B4B12" BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="สถานะความปลอดภัยในการส่ง">
                        <TextBlock x:Name="SafetyBadgeText" Text="TEST MODE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource WarningText}" />
                    </Border>
                    <Border x:Name="AutoRunBadge" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="ตัวรันอัตโนมัติ: งานที่ยืนยันแล้วจะส่งต่อเองเมื่อบัญชีเชื่อมต่อ">
                        <TextBlock x:Name="AutoRunBadgeText" Text="AUTO-RUN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AccountSwitchNotice}" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="AccountSwitchBox" Width="250" ItemsSource="{Binding AccountSummaries}" SelectedValuePath="Id" ToolTip="บัญชีที่ใช้งาน • เลือกเพื่อสลับทุกมุมมองไปอีกบัญชี">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Border}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Success}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StatusLine}" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Style="{StaticResource IconButton}" Content="&#xE710;" Margin="6,0,0,0" ToolTip="เพิ่มบัญชี" Click="AddAccount_Click" />
                    <Button x:Name="ConnectAccountButton" Content="เข้าสู่ระบบ" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="16,8" Click="ConnectAccount_Click" ToolTip="เริ่ม Authorization ของบัญชีที่เลือก" />
                    <Border Width="1" Height="24" Background="{StaticResource Border}" Margin="14,0" />
                    <Button x:Name="EmergencyStopButton" Style="{StaticResource IconButton}" Content="&#xE71A;" Foreground="{StaticResource DangerText}" ToolTip="หยุดฉุกเฉิน (Kill switch)" Click="EmergencyStop_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8CB;" ToolTip="คิวงาน" Click="Queue_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE81C;" ToolTip="ประวัติการทำงาน" Click="History_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="ตั้งค่า" Click="Settings_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0" Padding="14,12,14,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Button Style="{StaticResource NavButtonActive}" Tag="&#xE724;" Content="ส่งข้อความ" />
                            <Button Style="{StaticResource NavButton}" Tag="&#xE716;" Content="จัดการผู้รับ" Click="FocusRecipients_Click" />

                            <TextBlock Text="เครื่องมือ" Style="{StaticResource SectionLabel}" Margin="10,12,0,6" />
                            <Button Style="{StaticResource NavButton}" Tag="&#xE774;" Content="กลุ่มและแชนแนล" Click="Groups_Click" />
                            <Button Style="{StaticResource NavButton}" Tag="&#xE8A5;" Content="เทมเพลตและมีเดีย" Click="TemplateEditor_Click" />
                            <Button Style="{StaticResource NavButton}" Tag="&#xE8B7;" Content="Media Library" Click="MediaLibrary_Click" />
                            <Button Style="{StaticResource NavButton}" Tag="&#xE7C3;" Content="Campaign Wizard" Click="CampaignWizard_Click" />
                            <Button Style="{StaticResource NavButton}" Tag="&#xE71B;" Content="Invite Links" Click="InviteLinks_Click" />
                            <Button Style="{StaticResource NavButton}" Tag="&#xE823;" Content="Pending Requests" Click="PendingRequests_Click" />

                            <TextBlock Text="ระบบ" Style="{StaticResource SectionLabel}" Margin="10,12,0,6" />
                            <Button Style="{StaticResource NavButton}" Tag="&#xE8CB;" Content="คิวงาน" Click="Queue_Click" />
                            <Button Style="{StaticResource NavButton}" Tag="&#xE81C;" Content="ประวัติการทำงาน" Click="History_Click" />
                            <Button Style="{StaticResource NavButton}" Tag="&#xE896;" Content="นำเข้าผู้ติดต่อ" Click="ImportContacts_Click" />
                            <Button Style="{StaticResource NavButton}" Tag="&#xE898;" Content="ส่งออกผู้ติดต่อ" Click="ExportContacts_Click" />
                            <Button Style="{StaticResource NavButton}" Tag="&#xE713;" Content="ตั้งค่า" Click="Settings_Click" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Background="{StaticResource CardBgAlt}" Padding="12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Contacts ทั้งหมด" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding TotalContactsCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentText}" Margin="0,1,0,0" />
                            <TextBlock Text="รายชื่อในบัญชีนี้" Style="{StaticResource Caption}" />
                            <Border Height="1" Background="{StaticResource Border}" Margin="0,10,0,8" />
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="เลือกอยู่" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedCount}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentText}" />
                                <TextBlock Grid.Row="1" Text="อนุญาตให้ติดต่อ" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,7,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConsentContactsCount}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessText}" Margin="0,7,0,0" />
                                <TextBlock Grid.Row="2" Text="ยังไม่อนุญาต" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,7,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding NotAllowedContactsCount}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WarningText}" Margin="0,7,0,0" />
                            </Grid>
                            <TextBlock Text="Telegram Control Studio v0.1" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1" Margin="20,18,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ส่งข้อความแบบมีความยินยอม" Style="{StaticResource H1}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="เลือกผู้รับ จัดการสถานะ และเตรียมข้อความก่อนยืนยัน — ระบบยังไม่ส่งจนกว่าจะยืนยัน" Style="{StaticResource Subtitle}" Margin="0,6,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="รายงาน" Style="{StaticResource Caption}" FontSize="12" VerticalAlignment="Center" Margin="4,0,10,0" />
                            <DatePicker x:Name="StartDateBox" Width="128" ToolTip="วันที่เริ่มต้น" />
                            <TextBlock Text="ถึง" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0" />
                            <DatePicker x:Name="EndDateBox" Width="128" ToolTip="วันที่สิ้นสุด" />
                            <Button Content="ส่งออก CSV" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="ExportDashboardReport_Click" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="480" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <!-- Recipients card -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentSoft}" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="เลือกผู้รับ" Style="{StaticResource H2}" />
                                        <TextBlock Text="{Binding SelectionSummary}" FontSize="12" Foreground="{StaticResource InfoText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <ComboBox x:Name="SortBox" DockPanel.Dock="Right" Width="150" SelectedIndex="0" SelectionChanged="Sort_Changed" ToolTip="เรียงลำดับรายชื่อ">
                                    <ComboBoxItem Content="เรียง: ชื่อ" Tag="name" />
                                    <ComboBoxItem Content="เรียง: สถานะ" Tag="consent" />
                                </ComboBox>
                            </DockPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ContactSearchBox" Style="{StaticResource SearchTextBox}" Tag="ค้นหาชื่อ, Username หรือ Telegram ID..." KeyDown="ContactSearchBox_KeyDown" />
                                <Button Grid.Column="1" Content="ค้นหา" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Height="40" Click="SearchContacts_Click" />
                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE895;" Width="40" Height="40" Margin="8,0,0,0" ToolTip="โหลดรายชื่อใหม่" Click="RefreshContacts_Click" />
                                <Button Grid.Column="3" Content="ซิงก์ TDLib" Style="{StaticResource SecondaryButton}" Height="40" Margin="8,0,0,0" Click="SyncContacts_Click" ToolTip="ดึงรายชื่อจาก Telegram" />
                            </Grid>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton Style="{StaticResource FilterPill}" GroupName="ContactFilter" IsChecked="True" Content="{Binding AllContactsSummary}" Click="ShowAllContacts_Click" />
                                <RadioButton Style="{StaticResource FilterPill}" GroupName="ContactFilter" Content="{Binding ConsentedContactsSummary}" Click="ShowConsentedContacts_Click" />
                                <RadioButton Style="{StaticResource FilterPill}" GroupName="ContactFilter" Content="{Binding OptedOutContactsSummary}" Click="ShowOptedOutContacts_Click" />
                                <RadioButton Style="{StaticResource FilterPill}" GroupName="ContactFilter" Content="{Binding NotAllowedContactsSummary}" Click="ShowNotAllowedContacts_Click" />
                            </StackPanel>

                            <Border Grid.Row="3" Background="{StaticResource CardBgAlt}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,10">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                                        <TextBlock FontSize="12" Foreground="{StaticResource AccentText}">
                                            <Run Text="เลือกแล้ว " /><Run Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="Bold" /><Run Text=" รายชื่อ" />
                                        </TextBlock>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="SelectPageCheck" Content="เลือกหน้านี้" Click="SelectVisibleContacts_Click" VerticalAlignment="Center"
                                                  IsThreeState="True" IsChecked="{Binding PageSelectionState, Mode=OneWay}" />
                                        <Button Content="เลือกทั้งหมด" Style="{StaticResource GhostButton}" Click="SelectAllContacts_Click" Margin="10,0,0,0" />
                                        <Button Content="ยกเลิกทั้งหมด" Style="{StaticResource GhostButton}" Click="ClearSelection_Click" />
                                        <Button Content="ยกเลิกหน้านี้" Style="{StaticResource GhostButton}" Click="ClearPageSelection_Click" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Grid Grid.Row="4">
                                <DataGrid x:Name="ContactGrid" ItemsSource="{Binding Contacts}" IsReadOnly="False"
                                          SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                                          CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="50" CanUserResize="False">
                                            <DataGridTemplateColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <CheckBox HorizontalAlignment="Center" Click="SelectVisibleContacts_Click" ToolTip="เลือก/ยกเลิกผู้รับที่มองเห็นทั้งหมด"
                                                              IsThreeState="True"
                                                              IsChecked="{Binding DataContext.PageSelectionState, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.HeaderTemplate>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Click="ContactCheckBox_Click" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="ชื่อ" Width="*" MinWidth="200">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource AccentSoft}">
                                                            <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                                                   VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Telegram ID" Binding="{Binding Id}" Width="130" ElementStyle="{StaticResource GridTextCell}" />
                                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150" ElementStyle="{StaticResource GridTextCell}" />

                                        <DataGridTemplateColumn Header="สถานะ" Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ConsentBadge}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="ไม่พบรายชื่อในตัวกรองนี้" Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False" />
                            </Grid>

                            <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
                                <TextBlock Text="{Binding PageSummary}" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Width="30" Height="30" ToolTip="ก่อนหน้า" Click="PrevPage_Click" />
                                    <ItemsControl ItemsSource="{Binding PageNumbers}" Margin="4,0" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Tag="{Binding Number}" Click="PageNumber_Click" Content="{Binding Number}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PagerButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource AccentGradient}" />
                                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Width="30" Height="30" ToolTip="ถัดไป" Click="NextPage_Click" />
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- Right panel -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                        <TabControl x:Name="RightTabs" Style="{StaticResource PillTabControl}" ItemContainerStyle="{StaticResource PillTabItem}" SelectedIndex="0">
                            <TabItem Header="1 ผู้รับ">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="จัดการผู้รับที่เลือก" Style="{StaticResource H3}" />
                                        <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource Subtitle}" Margin="0,4,0,14" />

                                        <Border Background="{StaticResource InfoSoft}" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                                            <DockPanel>
                                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource InfoText}" Margin="0,1,10,0" VerticalAlignment="Top" />
                                                <TextBlock Text="การเปลี่ยนสถานะจะใช้กับผู้รับที่เลือกทั้งหมด ทุกหน้า" FontSize="12" Foreground="{StaticResource InfoText}" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="ผ่าน Consent" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedConsentCount}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessText}" />
                                            <TextBlock Grid.Row="1" Text="ยังไม่อนุญาต" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedNotAllowedCount}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WarningText}" Margin="0,8,0,0" />
                                            <TextBlock Grid.Row="2" Text="Opt-out" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedOptOutCount}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DangerText}" Margin="0,8,0,0" />
                                        </Grid>

                                        <Border Height="1" Background="{StaticResource Border}" Margin="0,14,0,14" />

                                        <Button Content="ตั้งเป็น Consent" Style="{StaticResource SecondaryButton}" Click="SetConsent_Click" Margin="0,0,0,8" />
                                        <Button Content="ตั้งเป็น Opt-out" Style="{StaticResource SecondaryButton}" Click="SetOptOut_Click" Margin="0,0,0,8" />
                                        <Button Content="ลบที่เลือก (Soft Delete)" Style="{StaticResource DangerButton}" Click="DeleteSelectedContacts_Click" Margin="0,0,0,12" />

                                        <TextBlock Text="การเปลี่ยนสถานะจะถูกบันทึกในเครื่องทันที • ไม่มีการส่งข้อมูลออกไปยัง Telegram"
                                                   FontSize="11" Foreground="{StaticResource WarningText}" TextWrapping="Wrap" />

                                        <Button Content="ถัดไป: ข้อความ" Style="{StaticResource PrimaryButton}" Height="44" Margin="0,16,0,0"
                                                Click="ContinueToMessage_Click" IsEnabled="{Binding HasConsentedSelection}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="2 ข้อความ">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Margin="0,2,14,0">
                                            <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                                <TextBlock Text="ข้อความ" Style="{StaticResource H3}" VerticalAlignment="Center" />
                                                <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoft}" CornerRadius="9" Padding="9,3" VerticalAlignment="Center">
                                                    <TextBlock Text="ขั้นตอน 2/3" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentText}" />
                                                </Border>
                                            </DockPanel>

                                            <Border CornerRadius="14" Background="{StaticResource CardBgAlt}" Padding="14,8,14,4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid>
                                                        <TextBox Text="{Binding MessageDraft, UpdateSourceTrigger=PropertyChanged}" MaxLength="4096"
                                                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                                                 VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                                                                 Padding="0" MinHeight="64" MaxHeight="150" FontSize="13" Margin="0,0,26,0" />
                                                        <TextBlock Text="&#xE76E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextMuted}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" IsHitTestVisible="False" />
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Text="{Binding MessageCounter}" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,6,0,0" />
                                                </Grid>
                                            </Border>

                                            <TextBlock Text="ลิงก์ (ถ้ามี)" Style="{StaticResource FieldLabel}" Margin="0,8,0,5" />
                                            <Border CornerRadius="10" Background="{StaticResource InputBg}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid Height="36">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource TextMuted}"
                                                               Margin="12,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                                    <TextBox Grid.Column="1" Text="{Binding LinkDraft, UpdateSourceTrigger=PropertyChanged}" Background="Transparent"
                                                             BorderThickness="0" Padding="0" FontSize="12.5" VerticalContentAlignment="Center" />
                                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" Width="26" Height="26" FontSize="10"
                                                            Margin="6,0,7,0" ToolTip="ล้างลิงก์" Click="ClearLink_Click" />
                                                </Grid>
                                            </Border>

                                            <TextBlock Text="รูปภาพ" Style="{StaticResource FieldLabel}" Margin="0,8,0,5" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Width="60" Height="60" Cursor="Hand" Click="ComposeMedia_Click" ToolTip="เปิดคลังมีเดียในเครื่อง">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Grid>
                                                                <Rectangle x:Name="Frame" RadiusX="12" RadiusY="12" Fill="{StaticResource InputBg}"
                                                                           Stroke="{StaticResource BorderStrong}" StrokeThickness="1.5" StrokeDashArray="3 2" />
                                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                                                                    <TextBlock Text="คลังมีเดีย" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0" HorizontalAlignment="Center" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Frame" Property="Stroke" Value="{StaticResource AccentHover}" />
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter Property="Opacity" Value="0.85" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="แนบรูปผ่านเทมเพลต" FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                                                    <TextBlock Text="JPG, PNG, WEBP • ไม่เกิน 10 MB" FontSize="10.5" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>

                                            <Border Background="{StaticResource CardBgAlt}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="8,8" Margin="0,10,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="ตัวอย่างก่อนส่ง" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                                    <Border Background="#1B2436" CornerRadius="12" Padding="10,7">
                                                        <Grid>
                                                            <StackPanel Margin="0,0,26,0">
                                                                <TextBlock Text="{Binding PreviewMessage}" TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                                                           MaxHeight="64" Foreground="{StaticResource TextPrimary}" />
                                                                <TextBlock Text="{Binding PreviewLink}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource AccentText}" Margin="0,4,0,0"
                                                                           Visibility="{Binding HasPreviewLink, Converter={StaticResource BoolToVis}}" />
                                                            </StackPanel>
                                                            <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource AccentGradient}"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                                                <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="White"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Border Grid.Row="1" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding SelectedChipsSummary}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                                <Button DockPanel.Dock="Right" Content="แก้ไข" Style="{StaticResource GhostButton}" Padding="6,2" FontSize="11" Click="BackToRecipients_Click" />
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding SelectedPreviewChips}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource InputBg}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                                CornerRadius="14" Padding="3,3,4,3" Margin="0,0,5,5">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource AccentSoft}">
                                                                    <TextBlock Text="{Binding Initials}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource AccentText}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <TextBlock Text="{Binding Name}" FontSize="10.5" VerticalAlignment="Center" Margin="5,0,0,0"
                                                                           MaxWidth="84" TextTrimming="CharacterEllipsis" />
                                                                <Button Style="{StaticResource IconButton}" Content="&#xE711;" Width="18" Height="18" FontSize="9"
                                                                        Margin="4,0,0,0" ToolTip="เอาออกจากรายชื่อ" Click="DeselectChip_Click" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Style="{StaticResource SecondaryButton}" Height="40" Click="SaveDraftAsTemplate_Click" ToolTip="บันทึกข้อความนี้เป็นเทมเพลต">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                                                        <TextBlock Text="บันทึกเทมเพลต" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="40" Margin="8,0,0,0" Click="Review_Click"
                                                        IsEnabled="{Binding HasConsentedSelection}" ToolTip="ไปขั้นตอนตรวจสอบก่อนสร้าง Job">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Foreground="White" />
                                                        <TextBlock Text="ถัดไป: ตรวจสอบ" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <Grid Margin="2,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource WarningText}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding SendAvailabilityNotice}" FontSize="10" Foreground="{StaticResource WarningText}"
                                                           VerticalAlignment="Center" Margin="6,0,0,0" TextWrapping="Wrap" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <TabItem Header="3 ตรวจสอบ">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="ตรวจสอบก่อนสร้าง Job" Style="{StaticResource H3}" />
                                        <TextBlock Text="ขั้นตอน 3 จาก 3" Style="{StaticResource Subtitle}" Margin="0,4,0,14" />

                                        <Border Background="{StaticResource CardBgAlt}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="ผู้รับที่เลือก" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                                <TextBlock Grid.Column="1" Text="{Binding SelectedCount}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="1" Text="ผ่าน Consent" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedConsentCount}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessText}" Margin="0,8,0,0" />
                                                <TextBlock Grid.Row="2" Text="บัญชีที่ใช้งาน" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ActiveAccountStatus}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InfoText}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="ข้อความ" Style="{StaticResource FieldLabel}" />
                                        <Border Background="{StaticResource CardBgAlt}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                                            <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" MaxHeight="140" FontSize="12" />
                                        </Border>

                                        <Border Background="{StaticResource WarningSoft}" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                                            <DockPanel>
                                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource WarningText}" Margin="0,1,10,0" VerticalAlignment="Top" />
                                                <TextBlock Text="ระบบจะบันทึกงานเป็น WaitingForConfirmation และยังไม่ส่งจริง จนกว่าจะยืนยันในคิวงาน" FontSize="12" Foreground="{StaticResource WarningText}" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>

                                        <TextBlock Text="{Binding DataSourceNotice}" FontSize="11" Foreground="{StaticResource InfoText}" TextWrapping="Wrap" Margin="0,0,0,14" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Content="ย้อนกลับ" Style="{StaticResource SecondaryButton}" Click="BackToMessage_Click" />
                                            <Button Grid.Column="1" Content="สร้าง Job (ยังไม่ส่ง)" Style="{StaticResource PrimaryButton}" Height="40" Margin="8,0,0,0" Click="CreatePreview_Click" IsEnabled="{Binding HasConsentedSelection}" />
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
