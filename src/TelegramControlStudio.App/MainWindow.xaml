<Window x:Class="TelegramControlStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telegram Control Studio"
        Width="1280" Height="760"
        MinWidth="1024" MinHeight="640"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0B1220" Padding="18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="TELEGRAM CONTROL" FontSize="17" FontWeight="Bold" />
                    <TextBlock Text="STUDIO" FontSize="17" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,28" />
                </StackPanel>
                <StackPanel>
                    <Button Content="Dashboard" Padding="12" Margin="0,0,0,8" />
                    <Button Content="Accounts" Padding="12" Margin="0,0,0,8" />
                    <Button Content="Groups &amp; Channels" Padding="12" Margin="0,0,0,8" />
                    <Button Content="Contacts" Padding="12" Margin="0,0,0,8" />
                    <Button Content="Campaigns" Padding="12" Margin="0,0,0,8" />
                    <Button Content="Invitations" Padding="12" Margin="0,0,0,8" />
                    <Button Content="Media &amp; Templates" Padding="12" Margin="0,0,0,8" />
                    <Button Content="Activity Logs" Padding="12" Margin="0,0,0,8" />
                    <Button Content="Settings" Padding="12" Margin="0,0,0,8" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" Padding="28" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Dashboard" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Local-first Telegram operations workspace" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,24" />
                <UniformGrid Columns="4" Margin="0,0,0,24">
                    <Border Background="{StaticResource PanelBrush}" Padding="18" Margin="0,0,12,0">
                        <StackPanel><TextBlock Text="Accounts" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="0" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" Padding="18" Margin="0,0,12,0">
                        <StackPanel><TextBlock Text="Connected Groups" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="0" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" Padding="18" Margin="0,0,12,0">
                        <StackPanel><TextBlock Text="Queued Jobs" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="0" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" Padding="18">
                        <StackPanel><TextBlock Text="Security" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Local-only" FontSize="20" FontWeight="Bold" Margin="0,12,0,0" Foreground="#34D399"/></StackPanel>
                    </Border>
                </UniformGrid>
                <Border Background="{StaticResource PanelBrush}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Getting started" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Phase 1 foundation is ready. TDLib is not connected and no Telegram account has been accessed." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,18" />
                        <Button Content="Add Telegram account" Width="180" HorizontalAlignment="Left" Padding="10" IsEnabled="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
