<Window x:Class="TelegramControlStudio.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Telegram Control Studio" Width="1440" Height="900" MinWidth="1180" MinHeight="700"
 Background="#08111F" Foreground="#F4F7FF">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#D9E2F2"/><Setter Property="Background" Value="#101F35"/><Setter Property="BorderBrush" Value="#233C60"/><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="BorderThickness" Value="0"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#0D1A2D" BorderBrush="#1C3556" BorderThickness="0,0,0,1" Padding="22,0">
   <DockPanel VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal">
     <Border Width="38" Height="38" CornerRadius="19" Background="#229ED9" Margin="0,0,12,0"><TextBlock Text="➤" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock Text="Telegram Control Studio" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <TextBlock Text="  v0.1" Foreground="#9C6CFF" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
     <Border Background="#073D35" BorderBrush="#10B981" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="16,0,0,0"><TextBlock Text="LOCAL" Foreground="#34D399" FontWeight="Bold" FontSize="11"/></Border>
    </StackPanel>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><ComboBox Width="190" ItemsSource="{Binding Accounts}" SelectedItem="{Binding ActiveAccount}" DisplayMemberPath="DisplayName" ToolTip="บัญชีที่ใช้งาน"/><Button Content="⚙  ตั้งค่า" Margin="8,0,0,0"/><Button Content="▤  ข้อมูล" Margin="8,0,0,0"/><Button Content="▣  ประวัติ" Margin="8,0,0,0"/></StackPanel>
   </DockPanel>
  </Border>
  <Border Grid.Row="1" Grid.Column="0" Background="#0A1627" Padding="14,18">
   <DockPanel>
    <StackPanel DockPanel.Dock="Bottom"><Border Background="#101F35" CornerRadius="8" Padding="12" Margin="0,18,0,0"><StackPanel><TextBlock Text="บัญชีที่ใช้งาน" Foreground="#8FA6C6"/><TextBlock Text="{Binding ActiveAccountStatus}" Foreground="#60A5FA" Margin="0,6,0,0" TextWrapping="Wrap"/><TextBlock Text="สถานะระบบ" Foreground="#8FA6C6" Margin="0,10,0,0"/><TextBlock Text="{Binding QueueSummary}" Foreground="#34D399" Margin="0,6,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding PendingRequestsSummary}" Foreground="#FBBF24" Margin="0,6,0,0" TextWrapping="Wrap"/><TextBlock Text="ประวัติล่าสุด" Foreground="#8FA6C6" Margin="0,12,0,4"/><ItemsControl ItemsSource="{Binding ActivityLogs}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#AFC3DF" TextWrapping="Wrap" Margin="0,2,0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><TextBlock Text="Telegram Control Studio" Foreground="#7187A7" Margin="4,18,0,0"/><TextBlock Text="Foundation UI • Phase 1" Foreground="#7187A7" Margin="4,4,0,0"/></StackPanel>
    <StackPanel><Button Style="{StaticResource Nav}" Content="✈  ส่งข้อความ" Background="#3B237D" Foreground="White"/><Button Style="{StaticResource Nav}" Content="♙  จัดการผู้รับ"/><Button Style="{StaticResource Nav}" Content="⇩  Import Contacts" Click="ImportContacts_Click"/><Button Style="{StaticResource Nav}" Content="▤  กลุ่มและแชนแนล"/><Button Style="{StaticResource Nav}" Content="▣  เทมเพลตและมีเดีย" Click="TemplateEditor_Click"/><Button Style="{StaticResource Nav}" Content="▥  Campaign Wizard" Click="CampaignWizard_Click"/><Button Style="{StaticResource Nav}" Content="◷  คิวงานและประวัติ"/><Button Style="{StaticResource Nav}" Content="◉  Pending Requests" Click="PendingRequests_Click"/><Button Style="{StaticResource Nav}" Content="⚙  ตั้งค่า"/><Button Style="{StaticResource Nav}" Content="＋  เพิ่มบัญชี" Click="AddAccount_Click"/></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1" Grid.Column="1" Margin="18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,14"><TextBlock Text="ส่งข้อความแบบมีความยินยอม" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="เลือกผู้รับ ตรวจสอบข้อความ และยืนยันก่อนสร้าง Job" Foreground="#8FA6C6" Margin="0,5,0,0"/></StackPanel>
   <Border Grid.Row="1" Grid.Column="0" Background="#0D1A2D" BorderBrush="#1D395D" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,14,0">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top"><DockPanel Margin="0,0,0,14"><TextBlock Text="เลือกผู้รับ" FontSize="19" FontWeight="SemiBold"/><ComboBox Width="130" SelectedIndex="0" HorizontalAlignment="Right"><ComboBoxItem Content="เรียง: ชื่อ"/><ComboBoxItem Content="เรียง: สถานะ"/></ComboBox></DockPanel><DockPanel Margin="0,0,0,12"><TextBox Text="ค้นหาชื่อ หรือ Telegram ID..." Padding="12" Background="#101F35" Foreground="#AFC3DF" BorderBrush="#29486E"/><Button Content="ค้นหา" Width="92" Margin="10,0,0,0" Background="#6941E8" Foreground="White"/></DockPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Button Content="ทั้งหมด (0)" Background="#3B237D" Foreground="White" Margin="0,0,8,0"/><Button Content="ได้รับความยินยอม (0)" Margin="0,0,8,0"/><Button Content="ยังไม่อนุญาต (0)" Margin="0"/></StackPanel></StackPanel>
     <DataGrid ItemsSource="{Binding Contacts}" AutoGenerateColumns="False" IsReadOnly="True" Background="#0A1627" Foreground="#D9E2F2" BorderBrush="#203A5D" RowBackground="#0D1A2D" AlternatingRowBackground="#10213A"><DataGrid.Columns><DataGridCheckBoxColumn Header="เลือก" Width="55" Binding="{Binding Selected}"/><DataGridTextColumn Header="ชื่อ" Width="*" Binding="{Binding Name}"/><DataGridTextColumn Header="Telegram ID" Width="120" Binding="{Binding Id}"/><DataGridTextColumn Header="Username" Width="120" Binding="{Binding Username}"/><DataGridTextColumn Header="สถานะ" Width="115" Binding="{Binding Consent}"/></DataGrid.Columns></DataGrid>
     <TextBlock DockPanel.Dock="Bottom" Text="{Binding DataSourceNotice}" Foreground="#FBBF24" Margin="2,12,0,0"/>
    </DockPanel>
   </Border>
   <Border Grid.Row="1" Grid.Column="1" Background="#0D1A2D" BorderBrush="#1D395D" BorderThickness="1" CornerRadius="10" Padding="16">
    <StackPanel><TextBlock Text="สร้างข้อความ" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="ขั้นตอน 2 จาก 4" Foreground="#9C6CFF" Margin="0,4,0,18"/><TextBlock Text="ข้อความ" Foreground="#AFC3DF"/><TextBox Height="150" TextWrapping="Wrap" AcceptsReturn="True" Padding="12" Margin="0,7,0,14" Background="#101F35" Foreground="#D9E2F2" BorderBrush="#29486E" Text="ข้อความตัวอย่างสำหรับ Preview เท่านั้น"/><TextBlock Text="ลิงก์ (ถ้ามี)" Foreground="#AFC3DF"/><TextBox Padding="10" Margin="0,7,0,14" Background="#101F35" Foreground="#D9E2F2" BorderBrush="#29486E" Text="https://example.com"/><TextBlock Text="Preview" Foreground="#AFC3DF"/><Border Background="#182943" Padding="12" CornerRadius="8" Margin="0,7,0,18"><TextBlock Text="นี่คือ Preview ของข้อความที่จะส่ง&#10;ระบบจะตรวจ Consent และ Opt-out ก่อนสร้าง Job" Foreground="#D9E2F2" TextWrapping="Wrap"/></Border><Button Command="{Binding CreateJobCommand}" Content="ถัดไป: ตรวจสอบ" Background="#6941E8" Foreground="White" FontWeight="SemiBold" Padding="12"/><TextBlock Text="ยังไม่เชื่อม Telegram • จะไม่ส่งข้อความจริง" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel>
   </Border>
  </Grid>
 </Grid>
</Window>

