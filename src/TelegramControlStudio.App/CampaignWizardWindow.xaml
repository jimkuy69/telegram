<Window x:Class="TelegramControlStudio.App.CampaignWizardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Campaign Wizard" Width="650" Height="480" Background="#08111F" Foreground="#F4F7FF" WindowStartupLocation="CenterOwner">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="สร้าง Campaign แบบ Consent-first" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/><StackPanel Grid.Row="1"><TextBlock Text="ชื่อ Campaign"/><TextBox x:Name="NameBox" Padding="9" Margin="0,5,0,12"/><TextBlock Text="Template ID"/><TextBox x:Name="TemplateIdBox" Padding="9" Margin="0,5,0,12"/><TextBlock Text="Consent Policy"/><TextBox x:Name="PolicyBox" Text="เฉพาะผู้รับที่ยินยอมและไม่ Opt-out" Padding="9" Margin="0,5,0,12"/><TextBlock x:Name="RecipientSummary" Text="กำลังโหลดผู้รับ..." Foreground="#60A5FA"/><TextBlock Text="ระบบจะสร้าง Campaign และ Recipient เท่านั้น จะยังไม่ส่ง Telegram จริง" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,15,0,0"/></StackPanel><DockPanel Grid.Row="2"><Button Content="สร้าง Campaign" Click="Create_Click" Background="#6941E8"/><Button Content="ปิด" Click="Close_Click" HorizontalAlignment="Right" Margin="10,0,0,0"/></DockPanel></Grid>
</Window>

