<Window x:Class="TelegramControlStudio.App.PendingRequestsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pending Join Requests" Width="760" Height="520" Background="#08111F" Foreground="#E8F0FA" WindowStartupLocation="CenterOwner">
 <Window.Resources><Style x:Key="GridTextCell" TargetType="{x:Type TextBlock}"><Setter Property="Foreground" Value="#AFC3DA"/><Setter Property="TextWrapping" Value="NoWrap"/></Style></Window.Resources>
<Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="คำขอเข้าร่วมที่รอการตรวจสอบ" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="ต้องยืนยันและระบุเหตุผลก่อน Approve/Reject" Foreground="#FBBF24" Margin="0,5,0,12"/></StackPanel>
  <DataGrid x:Name="RequestsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="#0D1A2D" Foreground="#AFC3DA" BorderBrush="#203A5D" RowBackground="#0D1A2D" AlternatingRowBackground="#10213A"><DataGrid.Columns><DataGridTextColumn Header="Chat ID" Binding="{Binding ChatId}" Width="*" ElementStyle="{StaticResource GridTextCell}"/><DataGridTextColumn Header="Telegram User ID" Binding="{Binding TelegramUserId}" Width="*" ElementStyle="{StaticResource GridTextCell}"/><DataGridTextColumn Header="สถานะ" Binding="{Binding Status}" Width="120" ElementStyle="{StaticResource GridTextCell}"/><DataGridTextColumn Header="เวลาขอ" Binding="{Binding RequestedAt}" Width="180" ElementStyle="{StaticResource GridTextCell}"/></DataGrid.Columns></DataGrid>
  <DockPanel Grid.Row="2" Margin="0,14,0,0"><TextBox x:Name="ReasonBox" Width="300" Padding="9" ToolTip="เหตุผลที่ตัดสินใจ"/><Button Content="Reject" Click="Reject_Click" Background="#7F1D3A" Margin="10,0,0,0"/><Button Content="Approve" Click="Approve_Click" Background="#176B4D" Margin="8,0,0,0"/></DockPanel>
 </Grid>
</Window>

