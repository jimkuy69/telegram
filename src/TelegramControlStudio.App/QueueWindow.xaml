<Window x:Class="TelegramControlStudio.App.QueueWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Queue &amp; History" Width="1100" Height="650" Background="#08111F" Foreground="#F4F7FF"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,14"><TextBlock Text="คิวงานและประวัติ" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="จัดการสถานะงานในเครื่องและตรวจสอบประวัติการทำงาน" Foreground="#8FA6C6"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" AutoGenerateColumns="False" IsReadOnly="True" Background="#0A1627" Foreground="#D9E2F2"><DataGrid.Columns><DataGridTextColumn Header="สถานะ" Binding="{Binding Status}" Width="145"/><DataGridTextColumn Header="ประเภทงาน" Binding="{Binding TargetType}" Width="*"/><DataGridTextColumn Header="จำนวน" Binding="{Binding TargetCount}" Width="80"/><DataGridTextColumn Header="Retry" Binding="{Binding RetryCount}" Width="70"/><DataGridTextColumn Header="สร้างเมื่อ" Binding="{Binding CreatedAt}" Width="190"/><DataGridTextColumn Header="ข้อผิดพลาด" Binding="{Binding LastError}" Width="220"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0"><Button Content="รีเฟรช" Click="Refresh_Click" Width="100"/><Button Content="Pause" Click="Pause_Click" Width="100" Margin="8,0,0,0"/><Button Content="Resume" Click="Resume_Click" Width="100" Margin="8,0,0,0"/><Button Content="Retry" Click="Retry_Click" Width="100" Margin="8,0,0,0"/><Button Content="Cancel" Click="Cancel_Click" Width="100" Margin="8,0,0,0"/><TextBlock Text="สถานะเป็น local queue • ยังไม่ส่งข้อความจริง" Foreground="#FBBF24" VerticalAlignment="Center" Margin="18,0,0,0"/></StackPanel></Grid></Window>

