<Window x:Class="TelegramControlStudio.App.QueueWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Queue &amp; History" Width="1100" Height="680" Background="#08111F" Foreground="#E8F0FA">
    <Window.Resources>
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Foreground" Value="#0B1B33" />
            <Setter Property="TextElement.Foreground" Value="#0B1B33" />
            <Setter Property="Background" Value="#B9C7DA" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentStringFormat="{TemplateBinding ContentStringFormat}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" TextElement.Foreground="#0B1B33" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Foreground" Value="#E8F0FA" />
            <Setter Property="TextElement.Foreground" Value="#E8F0FA" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="TextElement.Foreground" Value="White" />
                    <Setter Property="Background" Value="#2563EB" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GridTextCell" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#AFC3DA" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="คิวงานและประวัติ" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="เลือกงานเพื่อดูรายการผู้รับ ใช้ตัวกรองเพื่อค้นหาสถานะงานได้เร็วขึ้น" Foreground="#8FA6C6" />
        </StackPanel>
        <Border x:Name="SafetyBanner" Grid.Row="1" Background="#2E2310" BorderBrush="#6B4B12" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="EmergencyStopButton" Content="หยุดฉุกเฉิน" Click="EmergencyStop_Click" Background="#7F1D3A" Foreground="White" Width="120" />
                    <Button x:Name="ClearEmergencyButton" Content="ปลดหยุดฉุกเฉิน" Click="ClearEmergency_Click" Margin="8,0,0,0" Width="140" />
                </StackPanel>
                <TextBlock x:Name="SafetyBannerText" Foreground="#FBBF24" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
            </DockPanel>
        </Border>
        <DockPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="กรองสถานะ:" Foreground="#C7D7EA" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="StatusFilterBox" Width="190" SelectedIndex="0" SelectionChanged="StatusFilter_Changed">
                <ComboBoxItem Content="ทั้งหมด" />
                <ComboBoxItem Content="Draft" />
                <ComboBoxItem Content="WaitingForConfirmation" />
                <ComboBoxItem Content="Queued" />
                <ComboBoxItem Content="Running" />
                <ComboBoxItem Content="Paused" />
                <ComboBoxItem Content="WaitingForFloodWait" />
                <ComboBoxItem Content="Completed" />
                <ComboBoxItem Content="PartiallyCompleted" />
                <ComboBoxItem Content="Failed" />
                <ComboBoxItem Content="Cancelled" />
            </ComboBox>
            <TextBlock x:Name="QueueSummaryText" Foreground="#60A5FA" VerticalAlignment="Center" Margin="18,0,0,0" />
        </DockPanel>
        <DataGrid x:Name="JobsGrid" Grid.Row="3" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" AutoGenerateColumns="False" IsReadOnly="True" Background="#0A1627" Foreground="#AFC3DA" MouseDoubleClick="Job_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="สถานะ" Binding="{Binding Status}" Width="170" ElementStyle="{StaticResource GridTextCell}" />
                <DataGridTextColumn Header="ประเภทงาน" Binding="{Binding TargetType}" Width="*" ElementStyle="{StaticResource GridTextCell}" />
                <DataGridTextColumn Header="จำนวน" Binding="{Binding TargetCount}" Width="80" ElementStyle="{StaticResource GridTextCell}" />
                <DataGridTextColumn Header="Retry" Binding="{Binding RetryCount}" Width="70" ElementStyle="{StaticResource GridTextCell}" />
                <DataGridTextColumn Header="สร้างเมื่อ" Binding="{Binding CreatedAt}" Width="190" ElementStyle="{StaticResource GridTextCell}" />
                <DataGridTextColumn Header="ข้อผิดพลาด" Binding="{Binding LastError}" Width="220" ElementStyle="{StaticResource GridTextCell}" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="รีเฟรช" Click="Refresh_Click" Width="100" />
            <Button Content="ยืนยันเข้าคิว" Click="Confirm_Click" Width="120" Margin="8,0,0,0" Background="#6941E8" Foreground="White" />
            <Button Content="หยุดชั่วคราว" Click="Pause_Click" Width="110" Margin="8,0,0,0" />
            <Button Content="ทำต่อ" Click="Resume_Click" Width="100" Margin="8,0,0,0" />
            <Button Content="ลองใหม่" Click="Retry_Click" Width="100" Margin="8,0,0,0" />
            <Button Content="ยกเลิก" Click="Cancel_Click" Width="100" Margin="8,0,0,0" />
            <TextBlock Text="ส่งจริงเมื่อยืนยัน • ต้องผ่าน Consent • เคารพโหมดทดสอบและหยุดฉุกเฉิน" Foreground="#FBBF24" VerticalAlignment="Center" Margin="18,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
