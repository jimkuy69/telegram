<Application x:Class="TelegramControlStudio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#111827" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1F2937" />
        <SolidColorBrush x:Key="TextBrush" Color="#E8F0FA" />
        <SolidColorBrush x:Key="MutedBrush" Color="#AFC3DA" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="Control">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#101F35" />
            <Setter Property="BorderBrush" Value="#29486E" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#101F35" />
            <Setter Property="BorderBrush" Value="#29486E" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#0B1B33" />
            <Setter Property="Background" Value="#E8F0FA" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#0B1B33" />
            <Setter Property="RowBackground" Value="#142742" />
            <Setter Property="AlternatingRowBackground" Value="#101F35" />
            <Setter Property="HorizontalGridLinesBrush" Value="#29486E" />
            <Setter Property="VerticalGridLinesBrush" Value="#29486E" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#142742" />
            <Setter Property="BorderBrush" Value="#29486E" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#0B1B33" />
            <Setter Property="Background" Value="#B8C7DA" />
            <Setter Property="BorderBrush" Value="#29486E" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Application.Resources>
</Application>