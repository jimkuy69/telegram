@page "/me"
@inject WorkspaceState Workspace
@inject AuthenticationStateProvider Auth

<PageTitle>สถานะของฉัน • Telegram Control Studio</PageTitle>

<div class="page-head">
    <div>
        <h1>สถานะของฉัน</h1>
        <p class="sub">ความยินยอมรับข้อความจากระบบนี้</p>
    </div>
    <button class="btn ghost" @onclick="LoadAsync" disabled="@_busy">รีเฟรช</button>
</div>

@if (_message is not null)
{
    <div class="banner @(_messageIsError ? "danger" : "ok") compact">@_message</div>
}

@if (_loading)
{
    <div class="card muted">กำลังโหลด…</div>
}
else if (_account is null)
{
    <div class="card"><p class="muted">ยังไม่มีบัญชี Telegram ในเครื่องนี้</p></div>
}
else if (_contact is null)
{
    <div class="card">
        <h2>ไม่พบคุณในรายชื่อผู้รับ</h2>
        <p class="muted">บัญชีนี้ยังไม่ถูกนำเข้าเป็นรายชื่อผู้รับของ <strong>@_account.DisplayName</strong></p>
        <p class="muted small-note">Telegram User ID ของคุณ: <span class="mono">@_userId</span></p>
    </div>
}
else
{
    <div class="grid-two">
        <div class="card">
            <h2>@_contact.FirstName @_contact.LastName</h2>
            <ul class="list">
                <li><span>Telegram User ID</span><span class="mono">@_contact.TelegramUserId</span></li>
                <li><span>Username</span><span class="mono">@(string.IsNullOrWhiteSpace(_contact.Username) ? "—" : "@" + _contact.Username)</span></li>
                <li><span>ความยินยอม</span><strong class="@(_contact.HasConsent && !_contact.IsOptedOut ? "ok-text" : "warn-text")">@StatusText</strong></li>
                <li><span>อัปเดตล่าสุด</span><span>@_contact.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></li>
            </ul>
            <p class="muted small-note">คุณเปลี่ยนสถานะได้เองทุกเมื่อ — ระบบจะไม่ส่งข้อความถึงคุณหากไม่มีความยินยอม</p>
        </div>

        <div class="card">
            <h2>จัดการความยินยอม</h2>
            @if (_contact.HasConsent && !_contact.IsOptedOut)
            {
                <p class="muted">สถานะปัจจุบัน: ให้ความยินยอมแล้ว</p>
                @if (_confirmOptOut)
                {
                    <div class="row-actions end">
                        <button class="btn ghost" @onclick="() => _confirmOptOut = false">ยกเลิก</button>
                        <button class="btn danger" @onclick="OptOutAsync" disabled="@_busy">ยืนยันถอนความยินยอม</button>
                    </div>
                }
                else
                {
                    <div class="row-actions end">
                        <button class="btn danger" @onclick="() => _confirmOptOut = true">ถอนความยินยอม (หยุดรับข้อความ)</button>
                    </div>
                }
            }
            else
            {
                <p class="muted">สถานะปัจจุบัน: @StatusText</p>
                <div class="row-actions end">
                    <button class="btn primary" @onclick="OptInAsync" disabled="@_busy">ให้ความยินยอมรับข้อความ</button>
                </div>
            }
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _busy;
    private bool _confirmOptOut;
    private string? _message;
    private bool _messageIsError;
    private long _userId;
    private Account? _account;
    private Contact? _contact;

    private string StatusText => _contact is null ? "—"
        : _contact.IsOptedOut ? "ถอนความยินยอม (opt-out)"
        : _contact.HasConsent ? "ให้ความยินยอมแล้ว"
        : "ยังไม่ให้ความยินยอม";

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        if (long.TryParse(state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id)) _userId = id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            await Workspace.LoadAsync();
            _account = Workspace.ActiveAccount;
            _contact = _account is null
                ? null
                : (await new ContactRepository(Workspace.DatabasePath).ListAsync(_account.Id))
                    .FirstOrDefault(contact => contact.TelegramUserId == _userId);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OptInAsync() => await ApplyAsync(consent: true, optOut: false);

    private async Task OptOutAsync()
    {
        _confirmOptOut = false;
        await ApplyAsync(consent: false, optOut: true);
    }

    private async Task ApplyAsync(bool consent, bool optOut)
    {
        if (_account is null) return;
        _busy = true;
        _message = null;
        try
        {
            var contacts = new ContactRepository(Workspace.DatabasePath);
            await contacts.SetOptOutAsync(_account.Id, _userId, optOut);
            await contacts.SetConsentAsync(_account.Id, _userId, consent);
            await new ActivityLogRepository(Workspace.DatabasePath).AppendAsync(new ActivityLog(
                _account.Id, null, "Info", optOut ? "ContactOptedOutSelf" : "ContactConsentSelf",
                $"User {_userId} {(optOut ? "opted out" : "consented")} from the web /me page.",
                DateTimeOffset.UtcNow));
            await LoadAsync();
            _message = optOut ? "บันทึกแล้ว — คุณจะไม่ได้รับข้อความจากระบบนี้" : "บันทึกแล้ว — คุณให้ความยินยอมรับข้อความ";
            _messageIsError = optOut;
        }
        finally
        {
            _busy = false;
        }
    }
}
