@page "/users"
@inject WorkspaceState Workspace
@inject AuthenticationStateProvider Auth

<PageTitle>ผู้ใช้และคำเชิญ • Telegram Control Studio</PageTitle>

<div class="page-head">
    <div>
        <h1>ผู้ใช้และคำเชิญ</h1>
        <p class="sub">ใครเข้าเว็บนี้ได้ และสร้างลิงก์เชิญให้เพื่อน</p>
    </div>
    <button class="btn ghost" @onclick="LoadAsync" disabled="@_busy">รีเฟรช</button>
</div>

@if (_message is not null)
{
    <div class="banner @(_messageIsError ? "danger" : "ok") compact">@_message</div>
}

@if (_createdLink is not null)
{
    <div class="card invite-created">
        <h2>ลิงก์เชิญใหม่</h2>
        <p class="mono selectable">@_createdLink</p>
        <p class="muted small-note">ส่งลิงก์นี้ให้เพื่อน — ใช้ได้ครั้งเดียว และหมดอายุตามที่กำหนด</p>
    </div>
}

<div class="grid-two">
    <div class="card">
        <h2>สร้างคำเชิญ</h2>
        <label class="field">
            <span>หมายเหตุ (ไม่บังคับ)</span>
            <input class="input" @bind="_inviteNote" placeholder="เช่น ชื่อเพื่อน / ช่องทางที่ส่งลิงก์" />
        </label>
        <label class="field">
            <span>อายุลิงก์</span>
            <select class="input" @bind="_inviteDays">
                <option value="1">1 วัน</option>
                <option value="7" selected>7 วัน</option>
                <option value="30">30 วัน</option>
            </select>
        </label>
        <div class="row-actions end">
            <button class="btn primary" @onclick="CreateInviteAsync" disabled="@_busy">สร้างลิงก์เชิญ</button>
        </div>
        <p class="muted small-note">ผู้ที่ล็อกอินด้วยลิงก์เชิญจะได้สิทธิ์ “เพื่อน” — ดูสถานะตัวเองและถอนความยินยอมได้เท่านั้น</p>
    </div>

    <div class="card">
        <h2>ที่อยู่เว็บสาธารณะ</h2>
        <label class="field">
            <span>ใช้สร้างลิงก์เชิญและแสดงในบอท</span>
            <input class="input mono" @bind="_baseUrl" placeholder="https://tcs.bn9.one" />
        </label>
        <div class="row-actions end">
            <button class="btn primary" @onclick="SaveBaseUrlAsync" disabled="@_busy">บันทึก</button>
        </div>
    </div>
</div>

<div class="card">
    <h2>ผู้ใช้เว็บ (@_users.Count)</h2>
    @if (_users.Count == 0)
    {
        <p class="muted">ยังไม่มีผู้ใช้</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>ชื่อ</th><th>Telegram ID</th><th>บทบาท</th><th>เข้าใช้ล่าสุด</th><th></th></tr></thead>
            <tbody>
                @foreach (var user in _users)
                {
                    <tr>
                        <td>@user.DisplayName @(user.IsBlocked ? "(ระงับ)" : "")</td>
                        <td class="mono">@user.TelegramUserId</td>
                        <td><span class="badge @(user.Role == AppUserRole.Owner ? "ok" : "muted")">@user.Role</span></td>
                        <td class="muted">@(user.LastLoginAt?.ToLocalTime().ToString("dd/MM HH:mm") ?? "—")</td>
                        <td class="end">
                            @if (user.TelegramUserId != _myId)
                            {
                                <button class="btn ghost" @onclick="() => ToggleBlockAsync(user)" disabled="@_busy">
                                    @(user.IsBlocked ? "คืนสิทธิ์" : "ระงับ")
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="card">
    <h2>คำเชิญล่าสุด</h2>
    @if (_invites.Count == 0)
    {
        <p class="muted">ยังไม่มีคำเชิญ</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>รหัส</th><th>หมายเหตุ</th><th>สร้าง</th><th>หมดอายุ</th><th>สถานะ</th><th></th></tr></thead>
            <tbody>
                @foreach (var invite in _invites)
                {
                    <tr>
                        <td class="mono">@invite.Code</td>
                        <td>@(string.IsNullOrWhiteSpace(invite.Note) ? "—" : invite.Note)</td>
                        <td class="muted">@invite.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                        <td class="muted">@(invite.ExpiresAt?.ToLocalTime().ToString("dd/MM HH:mm") ?? "ไม่หมดอายุ")</td>
                        <td><span class="badge @(InviteStatusClass(invite))">@InviteStatusText(invite)</span></td>
                        <td class="end">
                            @if (invite.IsRedeemable(DateTimeOffset.UtcNow))
                            {
                                <button class="btn ghost" @onclick="() => RevokeAsync(invite)" disabled="@_busy">ยกเลิก</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private bool _busy;
    private string? _message;
    private bool _messageIsError;
    private string? _createdLink;
    private string _inviteNote = string.Empty;
    private int _inviteDays = 7;
    private string _baseUrl = "https://tcs.bn9.one";
    private long _myId;
    private IReadOnlyList<AppUser> _users = [];
    private IReadOnlyList<Invite> _invites = [];

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        if (long.TryParse(state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id)) _myId = id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            _users = await new AppUserRepository(Workspace.DatabasePath).ListAsync();
            _invites = await new InviteRepository(Workspace.DatabasePath).ListAsync();
            var saved = await new AppSettingsRepository(Workspace.DatabasePath).GetAsync("public_base_url");
            if (!string.IsNullOrWhiteSpace(saved)) _baseUrl = saved;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CreateInviteAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            var invite = await new InviteRepository(Workspace.DatabasePath).CreateAsync(
                AppUserRole.Friend,
                _inviteNote,
                DateTimeOffset.UtcNow.AddDays(_inviteDays),
                _myId == 0 ? null : _myId);
            _createdLink = $"{BaseUrl}/invite/{invite.Code}";
            _inviteNote = string.Empty;
            await LoadAsync();
            _message = $"สร้างคำเชิญแล้ว • {invite.Code}";
            _messageIsError = false;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RevokeAsync(Invite invite)
    {
        _busy = true;
        try
        {
            await new InviteRepository(Workspace.DatabasePath).RevokeAsync(invite.Code);
            await LoadAsync();
            _message = $"ยกเลิกคำเชิญ {invite.Code} แล้ว";
            _messageIsError = false;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleBlockAsync(AppUser user)
    {
        _busy = true;
        try
        {
            await new AppUserRepository(Workspace.DatabasePath).SetBlockedAsync(user.TelegramUserId, !user.IsBlocked);
            await LoadAsync();
            _message = user.IsBlocked ? $"คืนสิทธิ์ให้ {user.DisplayName} แล้ว" : $"ระงับ {user.DisplayName} แล้ว";
            _messageIsError = false;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveBaseUrlAsync()
    {
        _busy = true;
        try
        {
            await new AppSettingsRepository(Workspace.DatabasePath).SetAsync("public_base_url", BaseUrl);
            _message = "บันทึกที่อยู่เว็บแล้ว";
            _messageIsError = false;
        }
        finally
        {
            _busy = false;
        }
    }

    private string BaseUrl => _baseUrl.Trim().TrimEnd('/');

    private static string InviteStatusText(Invite invite) =>
        invite.IsRevoked ? "ยกเลิกแล้ว"
        : invite.UsedAt is not null ? "ใช้แล้ว"
        : invite.IsRedeemable(DateTimeOffset.UtcNow) ? "ใช้ได้"
        : "หมดอายุ";

    private static string InviteStatusClass(Invite invite) =>
        invite.IsRedeemable(DateTimeOffset.UtcNow) ? "ok"
        : invite.UsedAt is not null ? "muted"
        : "warn";
}
