@page "/compose"
@inject WorkspaceState Workspace

<PageTitle>เขียนข้อความ • Telegram Control Studio</PageTitle>

<div class="page-head">
    <div>
        <h1>เขียนข้อความ</h1>
        <p class="sub">สร้างงานแบบ Consent-first — ยังไม่ส่งจริงจนกว่าจะยืนยันในคิวงาน</p>
    </div>
</div>

<SafetyBanner Settings="Workspace.Safety" />

@if (_result is not null)
{
    <div class="banner ok compact">@_result <a href="queue">ไปที่คิวงาน</a></div>
}

@if (Workspace.ActiveAccount is null)
{
    <div class="card empty">
        <h2>ยังไม่มีบัญชีในเครื่องนี้</h2>
        <p>เพิ่มบัญชีจากแอปเดสก์ท็อปก่อน</p>
    </div>
}
else if (Workspace.SelectedCount == 0)
{
    <div class="card empty">
        <h2>ยังไม่ได้เลือกผู้รับ</h2>
        <p>ไปที่หน้าผู้รับเพื่อเลือกคนที่ให้ความยินยอม แล้วกลับมาเขียนข้อความ</p>
        <a class="btn primary" href="recipients">ไปเลือกผู้รับ</a>
    </div>
}
else
{
    <div class="grid-two compose">
        <div class="card">
            <h2>ข้อความ</h2>

            <div class="chips selected-chips">
                @foreach (var contact in Workspace.SelectedContacts.Take(12))
                {
                    var state = ContactConsentPolicy.Classify(contact.HasConsent, contact.IsOptedOut);
                    <span class="chip static @(state == ContactConsentState.Consented ? "" : "muted")">
                        @($"{contact.FirstName} {contact.LastName}".Trim())
                        @if (state != ContactConsentState.Consented)
                        {
                            <small>• @ContactConsentPolicy.Label(state)</small>
                        }
                    </span>
                }
                @if (Workspace.SelectedCount > 12)
                {
                    <span class="chip static muted">+@(Workspace.SelectedCount - 12) ราย</span>
                }
            </div>

            <p class="muted small-note">
                เลือกไว้ @Workspace.SelectedCount ราย • ผ่าน Consent @Workspace.SelectedConsentedCount ราย
                @if (Workspace.SelectedCount > Workspace.SelectedConsentedCount)
                {
                    <span> — รายที่ไม่ผ่าน Consent จะถูกข้าม</span>
                }
            </p>

            <label class="field">
                <span>ข้อความ</span>
                <textarea class="input" rows="8" maxlength="4096" placeholder="พิมพ์ข้อความที่ต้องการส่ง…" @bind="_message" @bind:event="oninput"></textarea>
            </label>
            <div class="counter">@_message.Length / 4096</div>

            <label class="field">
                <span>ลิงก์ (ถ้ามี)</span>
                <input class="input" type="url" placeholder="https://…" @bind="_link" @bind:event="oninput" />
            </label>

            <label class="check-row">
                <input type="checkbox" @bind="_confirmed" />
                <span>ฉันตรวจสอบผู้รับ ข้อความ และลิงก์แล้ว</span>
            </label>

            @if (_error is not null)
            {
                <div class="banner danger compact">@_error</div>
            }

            <div class="row-actions end">
                <a class="btn ghost" href="queue">ไปที่คิวงาน</a>
                <button class="btn primary" @onclick="CreateJobAsync" disabled="@(_busy || !_confirmed)">สร้าง Job (รอยืนยัน)</button>
            </div>
        </div>

        <div class="card preview">
            <h2>ตัวอย่างข้อความ</h2>
            <div class="chat-bubble">
                @if (string.IsNullOrWhiteSpace(_message))
                {
                    <span class="muted">พิมพ์ข้อความเพื่อดูตัวอย่าง</span>
                }
                else
                {
                    <span>@_message</span>
                    @if (!string.IsNullOrWhiteSpace(_link)) { <a href="@_link" target="_blank" rel="noreferrer">@_link</a> }
                }
            </div>
            <p class="muted small-note">Job จะถูกบันทึกเป็นสถานะ “รอยืนยัน” และยังไม่ส่งข้อความจริง</p>
        </div>
    </div>
}

@code {
    private const int MessageLimit = 4096;

    private string _message = string.Empty;
    private string _link = string.Empty;
    private bool _confirmed;
    private bool _busy;
    private string? _error;
    private string? _result;

    protected override async Task OnInitializedAsync() => await Workspace.LoadAsync();

    private async Task CreateJobAsync()
    {
        _error = null;
        _result = null;

        var account = Workspace.ActiveAccount;
        if (account is null) { _error = "ยังไม่มีบัญชีที่เลือก"; return; }

        var recipients = Workspace.SelectedContacts
            .Where(contact => contact.HasConsent && !contact.IsOptedOut)
            .ToArray();
        if (recipients.Length == 0) { _error = "ยังไม่มีผู้รับที่ผ่าน Consent ในรายการที่เลือก"; return; }
        if (string.IsNullOrWhiteSpace(_message)) { _error = "กรุณากรอกข้อความก่อนสร้าง Job"; return; }
        if (_message.Length > MessageLimit) { _error = $"ข้อความยาวเกิน {MessageLimit} ตัวอักษร"; return; }
        if (!_confirmed) { _error = "กรุณาติ๊กยืนยันว่าตรวจสอบแล้ว"; return; }

        _busy = true;
        try
        {
            var link = string.IsNullOrWhiteSpace(_link) ? null : _link.Trim();
            var definition = $"{account.Id}|{string.Join("|", recipients.Select(contact => contact.TelegramUserId).Order())}|{_message}|{link}";
            var idempotencyKey = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(definition)));

            var jobRepository = new JobRepository(Workspace.DatabasePath);
            var jobId = await jobRepository.CreateAsync(account.Id, "ConsentMessaging", recipients.Length, idempotencyKey, _message.Trim(), link);

            var itemRepository = new JobItemRepository(Workspace.DatabasePath);
            if ((await itemRepository.ListAsync(jobId)).Count == 0)
            {
                var items = recipients.Select(contact => new JobItem(
                    jobId,
                    account.Id,
                    contact.TelegramUserId,
                    JobStatus.WaitingForConfirmation.ToString(),
                    0,
                    Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes($"{jobId:D}|{account.Id}|{contact.TelegramUserId}"))),
                    null,
                    DateTimeOffset.UtcNow));
                await itemRepository.CreateAsync(items);
            }

            await new ActivityLogRepository(Workspace.DatabasePath).AppendAsync(new ActivityLog(
                account.Id,
                jobId,
                "Info",
                "JobCreatedWeb",
                $"Created job from web host for {recipients.Length} consented recipient(s).",
                DateTimeOffset.UtcNow));

            _result = $"สร้าง Job สำเร็จ • Job ID {jobId} • สถานะรอยืนยัน • ยังไม่มีการส่งจริง";
            _confirmed = false;
        }
        catch (Exception)
        {
            _error = "สร้าง Job ไม่สำเร็จ กรุณาตรวจสอบคิวงานและ activity log";
        }
        finally
        {
            _busy = false;
        }
    }
}
