@page "/login"
@layout Layout.LoginLayout
@inject WorkspaceState Workspace
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>เข้าสู่ระบบ • Telegram Control Studio</PageTitle>

@if (_loading)
{
    <div class="card login-card muted">กำลังโหลด…</div>
}
else if (!BotSecrets.IsSupported)
{
    <div class="card login-card">
        <h2>ยังตั้งค่าไม่ได้บนระบบนี้</h2>
        <p class="muted">การเก็บ bot token ต้องใช้ Windows DPAPI</p>
    </div>
}
else if (!_hasToken || _showResetForm)
{
    <div class="card login-card">
        <h2>@(_hasToken ? "เปลี่ยน bot token" : "ตั้งค่าครั้งแรก")</h2>
        <p class="muted small-note">
            สร้างบอทกับ <strong>@@BotFather</strong> ใน Telegram (/newbot) แล้วนำ token มาวางที่นี่
            จากนั้นตั้งโดเมนของปุ่มล็อกอินด้วยคำสั่ง <span class="mono">/setdomain</span> → <span class="mono">@_host</span>
            (ใส่โดเมนเปล่า ๆ ไม่ต้องมี <span class="mono">https://</span> และไม่มี <span class="mono">/</span> ปิดท้าย)
        </p>
        <form method="post" action="/setup/bot" class="login-form">
            <AntiforgeryToken />
            <label class="field">
                <span>Bot token</span>
                <input class="input mono" name="token" type="password" autocomplete="off" placeholder="123456789:AA…" required />
            </label>
            @if (_hasToken)
            {
                <label class="field">
                    <span>Token เดิม (ใช้ยืนยันว่าเป็นเจ้าของระบบ)</span>
                    <input class="input mono" name="previous_token" type="password" autocomplete="off" />
                </label>
                <p class="muted small-note">
                    เปลี่ยน token ได้เฉพาะเมื่อ token เดิมใช้งานไม่ได้แล้ว — ถ้าระบบยังไม่มีผู้ใช้เลย ไม่ต้องกรอกช่องนี้
                </p>
            }
            <button class="btn primary" type="submit">@(_hasToken ? "เปลี่ยน token" : "บันทึก token")</button>
        </form>
        @if (!_hasToken)
        {
            <p class="muted small-note">ผู้ที่ล็อกอินคนแรกจะกลายเป็นเจ้าของระบบ (Owner)</p>
        }
        else
        {
            <p class="muted small-note"><a href="/login">← กลับไปหน้าเข้าสู่ระบบ</a></p>
        }
    </div>
}
else
{
    <div class="card login-card">
        <h2>เข้าสู่ระบบ</h2>
        <p class="muted small-note">ใช้บัญชี Telegram ของคุณ — ไม่ต้องใช้รหัสผ่าน</p>
        <div id="tg-login" class="tg-login-slot"></div>
        <p class="muted small-note">
            ถ้าปุ่มขึ้นว่า <span class="mono">Bot domain invalid</span> แปลว่ายังไม่ได้ตั้งโดเมนให้ตรงกับ
            <span class="mono">@_host</span> — เปิด <strong>@@BotFather</strong> → <span class="mono">/setdomain</span> → พิมพ์ <span class="mono">@_host</span> แล้วรีเฟรชหน้านี้
        </p>
        <p class="muted small-note"><a href="/login?setup=reset">เปลี่ยน bot token</a></p>
    </div>
}

@if (Message is not null)
{
    <div class="banner @(IsError ? "danger" : "ok") compact">@Message</div>
}

@code {
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "uid")] public string? Uid { get; set; }
    [SupplyParameterFromQuery(Name = "name")] public string? Name { get; set; }
    [SupplyParameterFromQuery(Name = "setup")] public string? Setup { get; set; }
    [SupplyParameterFromQuery(Name = "invited")] public string? Invited { get; set; }
    [SupplyParameterFromQuery(Name = "bye")] public string? Bye { get; set; }

    private bool _loading = true;
    private bool _hasToken;
    private string? _botUsername;
    private string _host = string.Empty;

    private bool _showResetForm => _hasToken && Setup == "reset";

    private string? Message => Error switch
    {
        "verify" => "ลิงก์ล็อกอินไม่ถูกต้องหรือหมดอายุ — ลองกดปุ่มด้านบนอีกครั้ง",
        "notinvited" => $"บัญชีนี้ยังไม่ได้รับเชิญ (User ID {Uid}{(string.IsNullOrWhiteSpace(Name) ? "" : $" • {Name}")}) — ส่ง ID นี้ให้เจ้าของระบบ",
        "blocked" => "บัญชีนี้ถูกระงับการใช้งาน",
        "invite" => "ลิงก์เชิญไม่ถูกต้อง ถูกใช้แล้ว หรือหมดอายุ",
        "token" => "รูปแบบ token ไม่ถูกต้อง",
        "botapi" => "ติดต่อ Telegram ไม่สำเร็จ — ตรวจ token แล้วลองใหม่",
        "already" => "มี bot token ที่ใช้งานได้อยู่แล้ว — ถ้าต้องการเปลี่ยน ใช้ลิงก์ «เปลี่ยน bot token» ด้านล่าง",
        "previous" => "token เดิมไม่ถูกต้อง — ต้องกรอก token เดิมที่ระบบเก็บไว้เพื่อยืนยันตัวตน",
        _ => Setup == "ok" ? "บันทึก token แล้ว — ล็อกอินด้วย Telegram ได้เลย"
            : Invited == "1" ? "ลิงก์เชิญถูกต้อง — ล็อกอินเพื่อเข้าระบบ"
            : Bye == "1" ? "ออกจากระบบแล้ว"
            : null
    };

    private bool IsError => Error is not null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (Uri.TryCreate(Nav.Uri, UriKind.Absolute, out var uri)) _host = uri.Host;
            _hasToken = await BotSecrets.GetTokenAsync(Workspace.DatabasePath) is not null;
            _botUsername = await new AppSettingsRepository(Workspace.DatabasePath).GetAsync("bot_username");
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_loading && _hasToken && !_showResetForm && !string.IsNullOrWhiteSpace(_botUsername))
            await JS.InvokeVoidAsync("tcsMountTelegramLogin", "tg-login", _botUsername, "/auth/telegram");
    }
}
